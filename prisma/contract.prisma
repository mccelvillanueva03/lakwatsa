    @@index([memberId], map: "MemberSession_memberId_key", unique: true)
    @@index([tokenHash], map: "MemberSession_tokenHash_key", unique: true)
  }

  model PlannerSession {
    id        String                       @id(map: "PlannerSession_pkey") @onCreate(cuid(2))
    plannerId String
    tokenHash String
    expiresAt DateTime(storage: timestamp)
    createdAt DateTime(storage: timestamp) @default(now())
