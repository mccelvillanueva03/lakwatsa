    updatedAt          DateTime(storage: timestamp) @onCreate(now()) @onUpdate(now())
    memberSession      MemberSession?
    contributionVote   ContributionOption?          @relation(name: "Member_contributionVoteId_fkey", fields: [contributionVoteId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Member_contributionVoteId_fkey", index: false)
    contributionOption ContributionOption?          @relation(name: "Member_contribution_same_trip", fields: [tripId, contributionVoteId], references: [tripId, id], map: "Member_contribution_same_trip", index: false)
    dateVote           DateOption?                  @relation(name: "Member_dateVoteId_fkey", fields: [dateVoteId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Member_dateVoteId_fkey", index: false)
    dateOption         DateOption?                  @relation(name: "Member_date_same_trip", fields: [tripId, dateVoteId], references: [tripId, id], map: "Member_date_same_trip", index: false)
    destinationVote    DestinationOption?           @relation(name: "Member_destinationVoteId_fkey", fields: [destinationVoteId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Member_destinationVoteId_fkey", index: false)
    destinationOption  DestinationOption?           @relation(name: "Member_destination_same_trip", fields: [tripId, destinationVoteId], references: [tripId, id], map: "Member_destination_same_trip", index: false)
    trip               Trip                         @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Member_tripId_fkey", index: "Member_tripId_name_key")

    @@index([tripId, name], map: "Member_tripId_name_key", unique: true)
    @@check(expression: sql`("amountPaid" >= (0)::numeric)`, map: "Member_amountPaid_nonnegative")
  }

  model MemberSession {
    id        String                       @id(map: "MemberSession_pkey") @onCreate(cuid(2))
    memberId  String
    tokenHash String
    expiresAt DateTime(storage: timestamp)
    createdAt DateTime(storage: timestamp) @default(now())
