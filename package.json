{
  "name": "trip-lang",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma contract emit",
    "db:migrate": "prisma db migrate --to @contract",
    "typecheck": "tsc --noEmit",
    "db:adopt": "prisma db sign --no-advance-ref",
    "db:plan": "prisma migration plan",
    "db:dev": "prisma db migrate --to @contract --advance-ref db",
    "db:verify": "prisma db verify --strict",
    "prebuild": "npm run db:generate"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/orm-postgres": "8.0.0-rc.22",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "8.0.0-rc.29",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    },
    "@prisma/orm-toolchain": "8.0.0-rc.22"
  },
  "engines": {
    "node": ">=22.18.0 <23 || >=24.11.0 <25 || >=26"
  }
}
